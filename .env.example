# V1 n8n Cloud uses credentials in n8n, not this file.
# Non-secret configuration is in config/datasets.json, embedded in Configure.
# Three distinct sheet IDs/URLs belong there, not in environment variables.
# Reserved for an OPTIONAL future API import helper; no helper reads these yet.
N8N_BASE_URL=
N8N_API_KEY=
# Never enter Google OAuth tokens or sender credentials into lead rows.
