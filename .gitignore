# Default deny: only reviewed source, synthetic fixtures and documentation enter Git.
*
!/.gitignore
!/.gitattributes
!/.env.example
!/AGENTS.md
!/README.md
!/package.json
!/scripts/
!/scripts/*.js
!/scripts/*.py
!/tests/
!/tests/*.test.js
!/tests/fixtures/
!/tests/fixtures/leads.json
!/docs/
!/docs/*.md
!/config/
!/config/*.example.json
!/examples/
!/examples/*-headers.csv
!/examples/sample-leads.csv
!/examples/*.example.json
!/prompts/
!/prompts/*.md
!/schemas/
!/schemas/*.schema.json
!/schemas/send-ledger.sql
!/review/
!/review/*.css
!/review/*.js
!/review/*.html
!/.githooks/
!/.githooks/pre-commit
!/.github/
!/.github/pull_request_template.md
!/.github/git-audit-exceptions.json

# Never version account configuration, secrets, runtime state or provider exports.
private/
outputs/
workflows/
node_modules/
.env
.env.*
!.env.example
.mcp.json
**/.mcp.json
**/.env
**/.env.*
**/credentials*
**/*secret*.json
**/*secret*.js
**/*token*.json
**/*token*.txt
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.sqlite*
**/*.db*
**/*.xlsx
**/*.xls
**/*.zip
**/*.log
**/*.bak
**/*.before
**/*.sdk.js
**/*-local.json
**/*-before.json
**/*-after.json
**/*snapshot*.json
**/*execution*.json
/.github/workflows/

# Historical live-lead reports and data-specific validation utilities stay local.
/docs/setup.md
/docs/validation.md
/docs/research-integrity.md
/docs/phase-2-panel.md
/docs/phase-2-operational-loop.md
/docs/remaining-research-processing.md
/docs/operator-stage1-continuation-report.md
/scripts/build-draft-separation-validation.js
/scripts/build-integrity-proof.js
/scripts/build-panel-integrity-proof.js
/scripts/phase2-inbox-validation.js
/scripts/phase2-panel-validation.js
/scripts/release-preflight-validation.js
/scripts/report-autonomous-test.js
/scripts/report-provider-retest.js
